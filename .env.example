# Server-only origin of the authenticated invoice API.
INVOICE_API_BASE_URL=https://api.thefuture.university

# Optional server-only Bearer token if the invoice API requires one.
INVOICE_API_BEARER_TOKEN=

# Server-only portal login configuration. Never expose these as NEXT_PUBLIC variables.
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=replace-with-a-strong-password
PORTAL_SESSION_SECRET=replace-with-at-least-32-random-characters
